# Environment
.env

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.venv/
venv/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.dist_root/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code temp files
tmpclaude-*-cwd

# Build
backend/static/
*.egg-info/
dist/
build/

# Test coverage artifacts (enforced in CI, see docs/testing.md)
frontend/coverage/
backend/.coverage
backend/coverage.xml
backend/htmlcov/
mcp-server/.coverage
mcp-server/coverage.xml
mcp-server/htmlcov/

# JUnit XML reports — emitted in CI for the flake-pr-comment workflow
# (bead xq19y) and locally when running pytest/vitest with --junitxml.
backend/junit.xml
frontend/junit.xml
mcp-server/junit.xml

# pytest-benchmark local result store (bd-skqln.10). CI uses --benchmark-storage
# under /tmp; this guard catches local runs that default to ./.benchmarks/.
backend/.benchmarks/
backend/tests/performance/.benchmarks/

# User guide screenshots (may contain PII)
docs/images/

# Playwright run-time artifacts (bd-lln2x). The visual-regression
# baseline PNGs under e2e/visual/__screenshots__/ ARE checked in (they
# are the test oracle); only ephemeral run output is excluded.
test-results/
test-results-visual/
playwright-report/
frontend/test-results/

# Local MCP server config: carries the ECM host and can carry an API key
.mcp.json

# SQLite databases and their write-ahead sidecars. The runtime journal.db
# lives under CONFIG_DIR outside the tree, so anything matching here is a
# local artifact: a hand-made scratch copy, or a test database written into
# the working tree. The -wal and -shm files are separate patterns because
# they sit beside the database rather than inside it, and a stale pair left
# behind reads as corruption the next time that database is opened.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# pytest's tmp_path factory roots at the working directory when TMPDIR is
# unset, which is the usual case for a non-login shell. Each run leaves a
# full set of test databases behind and they accumulate silently: one local
# sweep reached 128 MB across ~180 files before anyone noticed.
pytest-of-*/

# tempfile.mkdtemp() falls back to the working directory under the same
# missing-TMPDIR condition, so scratch directories land at the repo root.
/tmp[a-z0-9_]*/
