# Environment
.env

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.venv/
venv/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.dist_root/
# CSS chunk-leak audit build output (vite.audit.config.ts). Was untracked AND
# unignored, so it polluted `git status` and broke `npm run lint`.
frontend/.audit-dist/
# Dev-only modal harness build output (bead enhancedchannelmanager-xhldy.1).
# Never deployed; produced by `vite build --config vite.harness.config.ts`.
frontend/.modal-harness-dist/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code temp files and local-only settings
tmpclaude-*-cwd
.claude/settings.local.json

# Build
backend/static/
*.egg-info/
dist/
build/
# `mkdocs build` (a required gate, see docs/shipping.md) writes here by
# default: mkdocs.yml sets no site_dir. Left untracked it trips the
# binary-artifacts ratchet on site/sitemap.xml.gz, which reads as a real
# finding rather than as build output nobody meant to keep.
site/

# Test coverage artifacts (enforced in CI, see docs/testing.md)
frontend/coverage/
backend/.coverage
backend/coverage.xml
backend/htmlcov/
mcp-server/.coverage
mcp-server/coverage.xml
mcp-server/htmlcov/

# Root-level coverage db, same artifact as backend/.coverage above but left
# by a pytest run invoked from the repo root instead of backend/; the
# subdir-scoped entry does not match this path.
/.coverage

# JUnit XML reports — emitted in CI for the flake-pr-comment workflow
# (bead xq19y) and locally when running pytest/vitest with --junitxml.
backend/junit.xml
frontend/junit.xml
mcp-server/junit.xml

# pytest-benchmark local result store (bd-skqln.10). CI uses --benchmark-storage
# under /tmp; this guard catches local runs that default to ./.benchmarks/.
backend/.benchmarks/
backend/tests/performance/.benchmarks/

# Screenshots of a live instance (may contain PII). The default is to ignore
# everything under docs/images/ — captures taken against a real instance can
# render Xtream stream URLs (provider password is in the path), provider
# hostnames, private/public IPs, real email addresses, and account usernames.
# This repository is public, so an accidental `git add` is unrecoverable.
#
# Exception (bd-2mluw): docs/images/user_guide/ is tracked. Those screenshots
# are captured against the sanitized documentation environment — placeholder
# hosts (dispatcharr.example.local), the `e2e_test` operator, pseudonymized
# provider names, empty credential fields, and provider-identifying strings
# blurred at capture time. Every file under it was individually PII-audited
# before being committed. Anything added there later must clear the same bar.
# `docs/images/*` (not `docs/images/`) is required: git will not descend into
# an excluded directory, so a negation under it can never re-include anything.
docs/images/*
!docs/images/user_guide/

# Playwright run-time artifacts (bd-lln2x). The visual-regression
# baseline PNGs under e2e/visual/__screenshots__/ ARE checked in (they
# are the test oracle); only ephemeral run output is excluded.
test-results/
test-results-visual/
playwright-report/
frontend/test-results/

# Local MCP server config: carries the ECM host and can carry an API key
.mcp.json

# SQLite databases and their write-ahead sidecars. The runtime journal.db
# lives under CONFIG_DIR outside the tree, so anything matching here is a
# local artifact: a hand-made scratch copy, or a test database written into
# the working tree. The -wal and -shm files are separate patterns because
# they sit beside the database rather than inside it, and a stale pair left
# behind reads as corruption the next time that database is opened.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# pytest's tmp_path factory roots at the working directory when TMPDIR is
# unset, which is the usual case for a non-login shell. Each run leaves a
# full set of test databases behind and they accumulate silently: one local
# sweep reached 128 MB across ~180 files before anyone noticed.
pytest-of-*/

# tempfile.mkdtemp() falls back to the working directory under the same
# missing-TMPDIR condition, so scratch directories land at the repo root.
/tmp[a-z0-9_]*/

# Local browser snapshots and downloads can contain instance credentials.
/snap-*.yml
/snap-*.yaml
/*-snap.yml
/*-snap.yaml
.playwright-mcp/

# Keep root scratch files out of commits; add an exception for new root docs.
/*.yml
/*.yaml
/*.png
/*.md
!/.semgrep.yml
!/docker-compose*.yml
!/docker-compose*.yaml
!/mkdocs.yml
!/AGENTS.md
!/CHANGELOG.md
!/CLAUDE.md
!/COMPONENTS.md
!/CONTRIBUTING.md
!/README.md
!/SECURITY.md
!/USER_GUIDE.md
!/rebuild-instructions.md
